<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Discount:PreferredCustomerPercent" value="5" />
    <add key="Discount:VolumeThreshold" value="100" />
    <add key="Discount:VolumePercent" value="10" />
    <add key="Discount:LoyaltyYearsPercent" value="1" />
    <add key="Discount:MaxPercent" value="20" />
    <add key="Audit:LogPath" value="~/App_Data/discount-audit.log" />
  </appSettings>
  <connectionStrings>
    <add name="LegacyOrders" connectionString="Server=LEGACYSQL01;Database=OrdersDb;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" executionTimeout="120" />
    <customErrors mode="RemoteOnly" />
    <sessionState mode="InProc" timeout="20" />
  </system.web>
  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly assemblyName="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral">
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
